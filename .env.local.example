NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# When Supabase keys are empty, APIs use an in-memory store (seeded for local demo).
# Set to 0 to start empty even in memory mode.
SPLITTAB_DEMO_SEED=1

# Public origin used in OAuth redirects and email-back links.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gmail split alerts (readonly). Restricted Google scope — test users only until verified.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
TOKEN_ENCRYPTION_KEY=

# Optional: cron + Pub/Sub
CRON_SECRET=
GMAIL_PUBSUB_TOPIC=

# Optional email-back for split prompts
RESEND_API_KEY=
RESEND_FROM=

